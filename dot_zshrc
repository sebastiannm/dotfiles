# Load ENVs if the file exists
if [ -f "$HOME/.dotfiles/.env" ]; then
    . "$HOME/.dotfiles/.env"
fi

if [ -f "$HOME/.dotfiles/.env.local" ]; then
    . "$HOME/.dotfiles/.env.local"
fi

# Load aliases if the file exists
if [ -f "$HOME/.dotfiles/.aliases" ]; then
    . "$HOME/.dotfiles/.aliases"
fi

# Load functions if the file exists
if [ -f "$HOME/.dotfiles/.functions" ]; then
    . "$HOME/.dotfiles/.functions"
fi

export HISTSIZE=1000000000
export SAVEHIST=$HISTSIZE
setopt EXTENDED_HISTORY
setopt autocd
autoload -U compinit; compinit

# Use Emacs-style Zsh line editing; Escape must not enter vi command mode.
bindkey -e
bindkey '^[[A' history-beginning-search-backward
bindkey '^[[B' history-beginning-search-forward

export EDITOR="vim"

typeset -U path PATH

path=(
  "$HOME/.npm-global/bin"
  "/opt/homebrew/opt/node@24/bin"
  "$HOME/.local/bin"
  $path
)

# The next line updates PATH for the Google Cloud SDK.
if [ -f "$HOME/code/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/code/google-cloud-sdk/path.zsh.inc"; fi

# The next line enables shell command completion for gcloud.
# if [ -f "$HOME/code/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/code/google-cloud-sdk/completion.zsh.inc"; fi

export STARSHIP_CONFIG=$HOME/.config/starship/starship.toml

eval "$(zoxide init zsh)"
eval "$(starship init zsh)"
